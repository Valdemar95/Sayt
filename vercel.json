{
  "version": 2,
  "builds": [
    {
      "src": "ai_helpers_final_2.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/webhook.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/(.*)",
      "dest": "/ai_helpers_final_2.html"
    }
  ]
}
